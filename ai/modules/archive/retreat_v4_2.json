        "    VariableGetArmyInfoNode($m.retreat.foe, 5, $m.retreat.efforce)",
        "    GetHexAroundFightingStrengthNode($m.retreat.hex, $m.retreat.ours, $m.retreat.tmp, 5, $m.retreat.force, $m.retreat.tmplist)",
        "    GetHexAroundFightingStrengthNode($m.retreat.hex, $m.retreat.theirs, $m.retreat.tmp, 8, $m.retreat.efforce, $m.retreat.tmplist)",
        "    VariableGetTroopsInfoNode($88dbc001, 13, $m.retreat.tstr)",
